# Supabase project settings -> API. Use the anon / publishable key only.
# NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: money in the krathong. Your PromptPay phone number (10 digits) or national ID (13 digits).
# Leave empty to hide the feature. This ends up in the public site bundle, like any VITE_ value.
VITE_PROMPTPAY_ID=
# Shown to payers so they can check the account name in their banking app.
VITE_PROMPTPAY_NAME=
